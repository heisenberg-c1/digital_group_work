# 本地配置
config.local.json

# 大文件保险：图片默认忽略，只白名单放行小图与图标
*.jpg
*.jpeg
*.png
*.tif
*.tiff
!samples/demo/*.jpg
!samples/demo/*.png
!tests/fixtures/*.png
!tests/fixtures/**/*.png
!assets/*.png
!assets/*.ico
!assets/**/*.png

# 编辑器
.vscode/
.idea/
Thumbs.db
desktop.ini
