# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# 构建产物
*.spec.bak

# 数据：原图与合成数据体积大，一律不进仓库
data/raw/*
data/synth/*
data/results/*
