# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# 构建产物
*.spec.bak

# 数据：原图与合成数据体积大，一律不进仓库
data/raw/*
data/synth/*
data/results/*
!data/**/.gitkeep

# 本地配置
config.local.json

# 大文件保险：图片默认忽略，只白名单放行小图与图标
*.jpg
*.jpeg
*.png
*.tif
*.tiff
!samples/demo/*.jpg
!samples/demo/*.png
!tests/fixtures/*.png
!tests/fixtures/**/*.png
!assets/*.png
!assets/*.ico
!assets/**/*.png

# 本地文档：Git 只跟踪 README.md，其余设计文档仅保留在本地
THIRD_PARTY_NOTICES.md
docs/
任务书及评分标准-*.md
选题调研报告-*.md
项目开发规划-*.md
项目计划书-*.md

# 历史备份
docscan-history-backup.bundle

# 编辑器
.vscode/
.idea/
Thumbs.db
desktop.ini
